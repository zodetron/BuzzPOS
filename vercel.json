{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    { "source": "/api/items",     "destination": "/api/items" },
    { "source": "/api/order",     "destination": "/api/order" },
    { "source": "/api/dashboard", "destination": "/api/dashboard" },
    { "source": "/(.*)",          "destination": "/index.html" }
  ]
}
